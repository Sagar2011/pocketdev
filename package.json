{
  "name": "pocketdev",
  "version": "1.1.0",
  "description": "A tiny animated desktop companion for Claude Code. Make it your mini-self.",
  "main": "app/main.cjs",
  "license": "MIT",
  "author": "Sagar",
  "homepage": "https://github.com/Sagar2011/pocketdev",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sagar2011/pocketdev.git"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 test/core.test.cjs test/runtime.test.cjs",
    "test:desktop": "electron test/desktop.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "format": "prettier --write \"**/*.{js,json,md}\""
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "prettier": "^3.9.9"
  },
  "build": {
    "appId": "dev.pocketdev.companion",
    "productName": "PocketDev",
    "icon": "app/icon.png",
    "artifactName": "PocketDev-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "plugin/scripts/state.cjs",
      "package.json",
      "LICENSE"
    ],
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "volta": {
    "node": "24.20.0",
    "npm": "12.0.0"
  },
  "dependencies": {}
}
